# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/shambani_link
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/shambani_link_test

# JWT & SECURITY
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# REDIS
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ELASTICSEARCH
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX_PREFIX=shambani

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=shambani-storage
AWS_REGION=eu-west-1

# PAYMENT GATEWAYS
MPESA_CONSUMER_KEY=your-mpesa-key
MPESA_CONSUMER_SECRET=your-mpesa-secret
MPESA_PASSKEY=your-mpesa-passkey
MPESA_SHORTCODE=174379

STRIPE_API_KEY=your-stripe-key
STRIPE_WEBHOOK_SECRET=your-webhook-secret

# SMS & COMMUNICATION
AFRICASTALKING_API_KEY=your-at-api-key
AFRICASTALKING_USERNAME=your-at-username

TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# USSD
USSD_CODE=14900
USSD_PROVIDER=africastalking

# AI & ML MODELS
HUGGINGFACE_API_TOKEN=your-hf-token
OPENAI_API_KEY=your-openai-key
GOOGLE_CLOUD_API_KEY=your-google-key

# WEATHER API
OPENWEATHERMAP_API_KEY=your-weather-api-key

# ENVIRONMENT
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1

# EMAIL
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# LOGGING
LOG_FILE=logs/app.log